{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noizy-consent-gateway",
  "main": "index.ts",
  "compatibility_date": "2026-03-27",
  "workers_dev": true,

  // Observability — first-class deploy requirement
  "observability": { "enabled": true },

  // ── Default bindings (development) ───────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-memory",
      "database_id": "7b813205-fd12-4a23-84a6-ce83bc49ec70"
    }
  ],

  "vars": {
    "NOIZY_ENV": "development",
    "SERVICE_NAME": "consent-gateway",
    "DEFAULT_REVOCATION_SLA_HOURS": "1",
    "CF_ACCOUNT": "5ba03939f87a498d0bbed185ee123946"
  },

  // ── Staging ──────────────────────────────────────────────────────────
  "env": {
    "staging": {
      "name": "noizy-consent-gateway-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-memory",
          "database_id": "7b813205-fd12-4a23-84a6-ce83bc49ec70"
        }
      ],
      "vars": {
        "NOIZY_ENV": "staging",
        "SERVICE_NAME": "consent-gateway",
        "DEFAULT_REVOCATION_SLA_HOURS": "1",
        "CF_ACCOUNT": "5ba03939f87a498d0bbed185ee123946"
      }
    },

    // ── Production ───────────────────────────────────────────────────────
    // Routes activate after noizy.ai zone transfer to CF account
    "production": {
      "name": "noizy-consent-gateway",
      // "routes": [
      //   { "pattern": "consent.noizy.ai/*", "zone_name": "noizy.ai" }
      // ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-memory",
          "database_id": "7b813205-fd12-4a23-84a6-ce83bc49ec70"
        }
      ],
      "vars": {
        "NOIZY_ENV": "production",
        "SERVICE_NAME": "consent-gateway",
        "DEFAULT_REVOCATION_SLA_HOURS": "1",
        "CF_ACCOUNT": "5ba03939f87a498d0bbed185ee123946"
      }
    }
  }
}
